{
    "name": "obsidian-plugin-s3-link",
    "version": "1.0.0",
    "description": "Obsidian plugin for including S3 links in notes",
    "main": "main.js",
    "scripts": {
        "dev": "node esbuild.config.mjs dev watch",
        "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs prod watch",
        "build:ci": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs prod",
        "test": "jest",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "type-coverage": "npx type-coverage --detail",
        "type-coverage:strict": "npx type-coverage --at-least 95 --detail"
    },
    "keywords": [
        "obsidian",
        "obsidian-plugin",
        "s3",
        "aws"
    ],
    "author": {
        "name": "Michael Wiesendanger",
        "email": "michael.wiesendanger@gmail.com",
        "url": "https://github.com/RagedUnicorn"
    },
    "homepage": "https://github.com/RagedUnicorn/obsidian-plugin-s3-link",
    "license": "MIT",
    "devDependencies": {
        "@eslint/js": "^9.17.0",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.10.3",
        "@typescript-eslint/eslint-plugin": "^8.19.0",
        "@typescript-eslint/parser": "^8.19.0",
        "esbuild": "^0.24.2",
        "eslint": "^9.17.0",
        "globals": "^15.14.0",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "obsidian": "^1.7.2",
        "ts-jest": "^29.2.5",
        "type-coverage": "^2.29.7",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.19.0"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.717.0",
        "@aws-sdk/s3-request-presigner": "^3.717.0",
        "@codemirror/view": "^6.36.2",
        "mitt": "^3.0.1"
    },
    "jest": {
        "transform": {
            "^.+\\.tsx?$": "ts-jest"
        },
        "testEnvironment": "jest-environment-jsdom",
        "testRegex": "(/test/.*|(\\.|/)(test|spec))\\.tsx?$",
        "testPathIgnorePatterns": [
            "/node_modules/",
            "/test/src/mocks/",
            "test/src/__mocks__/"
        ],
        "moduleFileExtensions": [
            "ts",
            "tsx",
            "js",
            "jsx",
            "json",
            "node"
        ]
    }
}
